--- a/system/vl.c
+++ b/system/vl.c
@@ -145,6 +145,23 @@
 #include "qemu/keyval.h"
 #include "memory-internal.h"

+#ifdef __ANDROID__
+#include <android/api-level.h>
+#include <malloc.h>
+#include <sys/system_properties.h>
+static void android_disable_tags(void)
+{
+#ifdef M_BIONIC_SET_HEAP_TAGGING_LEVEL
+    /* API 31 以降の mallopt で切る。それより前の端末（Android 11）はタグが付かない設定を前提にする */
+    if (android_get_device_api_level() >= 31) {
+        mallopt(M_BIONIC_SET_HEAP_TAGGING_LEVEL, 0);
+    }
+#endif
+}
+#else
+static void android_disable_tags(void) {}
+#endif
+
